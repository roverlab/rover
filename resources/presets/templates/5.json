      "name": "🏠 私有网络"
    },
    {
      "rule_set_build_in": [
        "acl:Apple"
      ],
      "outbound": "direct_out",
      "name": "🍎 苹果服务"
    },
    {
      "rule_set_build_in": [
        "acl:ChinaDomain",
        "acl:UnBan",
        "acl:SteamCN",
        "acl:ChinaMedia",
        "acl:Download"
      ],
      "outbound": "direct_out",
